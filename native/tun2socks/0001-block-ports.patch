diff --git a/src/hev-config.c b/src/hev-config.c
index ec02afb..50fff59 100644
--- a/src/hev-config.c
+++ b/src/hev-config.c
@@ -54,6 +54,14 @@ static int udp_read_write_timeout;
 static int limit_nofile;
 static int log_level;
 
+/*
+ * Destination ports that must never leave the tunnel, one bitmap per
+ * transport protocol. Filled from `misc.block-tcp` / `misc.block-udp`.
+ */
+#define BLOCK_PORTS_MAX 65536
+static unsigned int block_tcp[BLOCK_PORTS_MAX / 32];
+static unsigned int block_udp[BLOCK_PORTS_MAX / 32];
+
 static int
 hev_config_parse_tunnel_ipv4 (yaml_document_t *doc, yaml_node_t *base)
 {
@@ -379,6 +387,43 @@ hev_config_parse_log_level (const char *value)
     return HEV_LOGGER_WARN;
 }
 
+/*
+ * Parses a comma separated list of ports and port ranges ("443,8000-8100")
+ * into the given bitmap. Malformed input stops the parse, everything already
+ * collected is kept.
+ */
+static void
+hev_config_parse_block_ports (unsigned int *ports, const char *value)
+{
+    const char *p = value;
+
+    while (*p) {
+        unsigned long start, stop, port;
+        char *end;
+
+        if (*p == ',' || *p == ' ' || *p == '\t') {
+            p++;
+            continue;
+        }
+
+        start = strtoul (p, &end, 10);
+        if (end == p || start < 1 || start >= BLOCK_PORTS_MAX)
+            break;
+        stop = start;
+        p = end;
+        if (*p == '-') {
+            p++;
+            stop = strtoul (p, &end, 10);
+            if (end == p || stop < start || stop >= BLOCK_PORTS_MAX)
+                break;
+            p = end;
+        }
+
+        for (port = start; port <= stop; port++)
+            ports[port / 32] |= 1u << (port % 32);
+    }
+}
+
 static int
 hev_config_parse_misc (yaml_document_t *doc, yaml_node_t *base)
 {
@@ -434,6 +479,10 @@ hev_config_parse_misc (yaml_document_t *doc, yaml_node_t *base)
             log_level = hev_config_parse_log_level (value);
         else if (0 == strcmp (key, "limit-nofile"))
             limit_nofile = strtol (value, NULL, 10);
+        else if (0 == strcmp (key, "block-tcp"))
+            hev_config_parse_block_ports (block_tcp, value);
+        else if (0 == strcmp (key, "block-udp"))
+            hev_config_parse_block_ports (block_udp, value);
     }
 
     if (tcp_rw_timeout <= 0)
@@ -523,6 +572,8 @@ hev_config_reset (void)
     memset (log_file, 0, sizeof (log_file));
     memset (pid_file, 0, sizeof (pid_file));
     memset (&srv, 0, sizeof (srv));
+    memset (block_tcp, 0, sizeof (block_tcp));
+    memset (block_udp, 0, sizeof (block_udp));
 
     tun_mtu = 8500;
     multi_queue = 0;
@@ -805,3 +856,21 @@ hev_config_get_misc_log_level (void)
 {
     return log_level;
 }
+
+int
+hev_config_get_block_tcp (unsigned int port)
+{
+    if (port >= BLOCK_PORTS_MAX)
+        return 0;
+
+    return (block_tcp[port / 32] >> (port % 32)) & 1;
+}
+
+int
+hev_config_get_block_udp (unsigned int port)
+{
+    if (port >= BLOCK_PORTS_MAX)
+        return 0;
+
+    return (block_udp[port / 32] >> (port % 32)) & 1;
+}
