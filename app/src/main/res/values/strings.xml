    <!-- Blocked traffic -->
    <string name="block_title">Blocked traffic</string>
    <string name="block_hint">Matching traffic is refused before it leaves the tunnel. Browsers try QUIC (UDP 443) first and Hysteria 2 cannot accelerate UDP, so blocking it makes them switch to TCP, which is much faster on poor networks.</string>
